# Supabase — copy this file to .env.local and fill in values from
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to the browser; no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# Gates /internal/data-preview outside development (server-only)
INTERNAL_PREVIEW_TOKEN=

# Resend (transactional email — quote request confirmations). Leave blank
# to no-op sends locally; see docs/email-marketing-architecture.md.
RESEND_API_KEY=
EMAIL_FROM=
INTERNAL_NOTIFY_EMAIL=

# Supabase — copy this file to .env.local and fill in values from
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to the browser; no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# Gates /internal/data-preview outside development (server-only)
INTERNAL_PREVIEW_TOKEN=

# Resend (transactional email — quote request confirmations). Leave blank
# to no-op sends locally; see docs/email-marketing-architecture.md.
RESEND_API_KEY=
EMAIL_FROM=
INTERNAL_NOTIFY_EMAIL=

# HubSpot contact sync on form submit — the ownership play. Preferred path:
# the Forms Submissions API, which needs no auth and no Super Admin (the
# portal belongs to the host agency). Marketing → Forms → create a form with
# email / firstname / lastname / phone / message → Share → Embed code, and
# read both values off it: portalId and formId (the GUID). Set both to go
# live; leave blank to no-op the sync. See docs/lead-intelligence.md.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# Optional alternative to the two above: a private-app token (CRM v3, also
# attaches a Note). Settings → Integrations → Private Apps → create, with
# crm.objects.contacts read+write scope. Requires Super Admin, so it's only
# usable if the host agency grants it. Ignored when the Forms pair is set.
HUBSPOT_PRIVATE_APP_TOKEN=

# Supabase — copy this file to .env.local and fill in values from
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to the browser; no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# Gates /internal/data-preview and /internal/subscribers outside development
# (server-only)
INTERNAL_PREVIEW_TOKEN=

# Resend — https://resend.com/api-keys (server-only)
RESEND_API_KEY=
# Must be on a domain verified in Resend. Until you verify one, use
# onboarding@resend.dev for testing.
DIGEST_FROM_EMAIL=onboarding@resend.dev
# Optional — add once HubSpot's email-ingestion address is set up. Digest
# emails go here in addition to jordan.yates@luxurycruiseconnections.com.
HUBSPOT_INGEST_EMAIL=
# Signing secret for the Resend webhook that feeds /internal/campaigns.
# Resend → Webhooks → add endpoint https://<domain>/api/webhooks/resend,
# subscribe to email.delivered/opened/clicked/bounced, then copy the
# `whsec_...` signing secret here and into Vercel. (server-only)
RESEND_WEBHOOK_SECRET=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`.
# Generate one (e.g. `openssl rand -hex 32`) and set it in Vercel's project
# env vars too.
CRON_SECRET=

# Signing key for unsubscribe links. Generate with `openssl rand -hex 32`.
# The same value must be set here, in Vercel, and in the environment that runs
# scripts/dispatch-send.mjs — a mismatch makes every link in a send read as
# tampered with, and nobody can opt out. (server-only)
UNSUBSCRIBE_SECRET=

# --- Dispatch sender (scripts/dispatch-send.mjs) ---------------------------
# Service-account key with access to the contacts sheet, as raw JSON or a path
# to the file. Share the sheet with the account's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
DISPATCH_SHEET_ID=
# Must be a domain verified in Resend AND recognisable to the reader.
DISPATCH_FROM=
DISPATCH_REPLY_TO=
# CAN-SPAM requires a physical postal address in every commercial message.
DISPATCH_POSTAL_ADDRESS=2420 NE 186th St, Suite 300, Miami, FL 33180

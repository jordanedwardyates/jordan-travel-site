[
  { "template": "frame", "kicker": "The assumption", "text": "*Bigger ship, better holiday.*", "sub": "It isn't a rule.", "seconds": 4, "timecode": "0:00", "tone": "warn", "size": 116, "label": "BON V" },
  { "template": "frame", "text": "Size buys venues — and people to share them.", "seconds": 6, "timecode": "0:04", "size": 92 },
  { "template": "frame", "text": "The people arrive faster than the venues.", "seconds": 4, "timecode": "0:10", "tone": "warn" },
  { "template": "frame", "text": "Seats don't scale with cabins.", "sub": "Neither do tender boats.", "seconds": 4, "timecode": "0:14" },

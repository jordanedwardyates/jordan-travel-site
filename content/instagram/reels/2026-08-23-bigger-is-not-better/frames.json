  { "template": "frame", "text": "Ashore before breakfast is cleared.", "seconds": 5, "timecode": "0:26" },
  { "template": "frame", "text": "Bigger isn't worse. It's a different holiday.", "seconds": 6, "timecode": "0:31", "size": 92 },
